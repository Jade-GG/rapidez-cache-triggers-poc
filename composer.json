{
    "name": "rapidez/rapidez-cache-triggers-poc",
    "description": "This is my package rapidez-cache-triggers-poc",
    "keywords": [
        "rapidez",
        "rapidez-cache-triggers-poc"
    ],
    "homepage": "https://github.com/rapidez/rapidez-cache-triggers-poc",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Jade",
            "email": "jade@justbetter.nl",
            "role": "Developer"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "rapidez/core": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Rapidez\\RapidezCacheTriggersPoc\\": "src"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rapidez\\RapidezCacheTriggersPoc\\RapidezCacheTriggersPocServiceProvider"
            ]
        }
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "rapidez/coding-standards": "^1.0"
    }
}
